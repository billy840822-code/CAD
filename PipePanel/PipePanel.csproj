<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <OutputType>Library</OutputType>
    <AssemblyName>PipePanel</AssemblyName>
    <RootNamespace>PipePanel</RootNamespace>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AutoCAD 2020 = R23.1
      AutoCAD.NET.Model  covers acmgd.dll + acdbmgd.dll
      AutoCAD.NET.Core   covers accoremgd.dll
      ExcludeAssets=runtime: do NOT copy into output (AutoCAD loads them at runtime)
    -->
    <PackageReference Include="AutoCAD.NET.Model" Version="23.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AutoCAD.NET.Core" Version="23.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      AcWindows.dll (PaletteSet) is NOT on NuGet.
      Place a copy from your AutoCAD 2020 install into libs/AcWindows.dll
      and push to GitHub so Actions can find it.
      Local path: C:\Program Files\Autodesk\AutoCAD 2020\AcWindows.dll
    -->
    <Reference Include="AcWindows">
      <HintPath>libs/AcWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
